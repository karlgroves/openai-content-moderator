# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=omni-moderation-latest

# Google Perspective API Configuration
GOOGLE_PERSPECTIVE_API_KEY=your-google-perspective-api-key-here
PERSPECTIVE_API_ENABLED=true

# API Authentication.
# If set, clients must send a matching x-api-key header.
# Optional in development and test; REQUIRED when NODE_ENV=production --
# the app refuses to start rather than serve unauthenticated traffic.
API_SECRET_KEY=

# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration
# Comma-separated allowlist of exact origins. Leave blank to disable browser CORS.
# Wildcard '*' is rejected because credentials are enabled.
CORS_ORIGIN=http://localhost:3000